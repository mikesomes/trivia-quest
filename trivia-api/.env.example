SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
QUESTION_BANK_MIN_THRESHOLD=30
QUESTION_BANK_TOPUP_COUNT=15
CRON_SECRET=your-random-cron-secret
APP_ENV=development
APP_ORIGIN=https://your-app-domain.com

# Question-candidate pipeline (run-question-candidate-pipeline and the stages it calls)
AI_REVIEW_SECRET=your-random-ai-review-secret
AI_VERIFY_SECRET=your-random-ai-verify-secret
AI_EDITORIAL_SECRET=your-random-ai-editorial-secret
CANDIDATE_PROMOTION_SECRET=your-random-candidate-promotion-secret
AI_PIPELINE_TARGETS=[{"category":"famous_quotes","difficulty":"easy","count":5}]

# Admin endpoints (review-question-candidates, promote-question-candidate)
ADMIN_USER_IDS=uuid-of-admin-user-1,uuid-of-admin-user-2
