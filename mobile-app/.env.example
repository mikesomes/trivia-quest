EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=https://your-project.supabase.co/functions/v1
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Product analytics. Both Sentry and PostHog only send when EXPO_PUBLIC_ENV is
# "production", so a dev session never pollutes the data.
EXPO_PUBLIC_POSTHOG_KEY=phc_your-project-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
